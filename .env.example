# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FORMSPREE_FORM_ID: Optional Formspree Form ID for Contact Form submissions.
# When provided, form submissions forward to bkutikaitgbnofficial@gmail.com via https://formspree.io/f/{FORM_ID}
# Register free at https://formspree.io with bkutikaitgbnofficial@gmail.com to get your form ID (e.g. xvgopqzk).
VITE_FORMSPREE_FORM_ID=""

# VITE_CONTACT_FORM_ENDPOINT: Optional custom form submission webhook or API endpoint URL
# VITE_CONTACT_FORM_ENDPOINT="https://formspree.io/f/bkutikaitgbnofficial@gmail.com"
